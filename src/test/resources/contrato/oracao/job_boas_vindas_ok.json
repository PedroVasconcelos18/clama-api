      "html": "<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Bem-vinda ao Clama — seus dados de acesso</title>\n</head>\n<body style=\"margin:0; padding:0; background:#1a0a2e; font-family:Georgia, 'Times New Roman', serif;\">\n  <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"background:#1a0a2e;\">\n    <tr>\n      <td align=\"center\" style=\"padding:48px 24px;\">\n        <table role=\"presentation\" width=\"600\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"max-width:600px; background:#1a0a2e;\">\n          <!-- Header -->\n          <tr>\n            <td align=\"center\" style=\"padding-bottom:32px;\">\n              <h1 style=\"font-family:Georgia, 'Times New Roman', serif; font-size:48px; color:#f0c040; margin:0; letter-spacing:-1px;\">\n                Clama<span style=\"color:#fdf8f0;\">.</span>\n              </h1>\n            </td>\n          </tr>\n\n          <!-- Saudação -->\n          <tr>\n            <td style=\"color:#fdf8f0; font-size:18px; line-height:1.7; padding:0 24px;\">\n              <p style=\"margin:0 0 16px 0;\">Paz e bem, Maria.</p>\n              <p style=\"margin:0 0 16px 0;\">\n                Que alegria ter você aqui. Sua doação foi recebida com muito\n                carinho — e, com ela, criamos uma conta no Clama para você.\n              </p>\n              <p style=\"margin:0 0 24px 0;\">\n                Preparamos uma senha temporária de acesso abaixo. Use-a no seu\n                primeiro login e, logo em seguida, vamos pedir que você troque\n                por uma senha só sua.\n              </p>\n            </td>\n          </tr>\n\n          <!-- Divider dourado -->\n          <tr>\n            <td style=\"padding:0 24px;\">\n              <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\">\n                <tr>\n                  <td style=\"border-top:1px solid #f0c040; padding-top:32px;\"></td>\n                </tr>\n              </table>\n            </td>\n          </tr>\n\n          <!-- Bloco de Credenciais -->\n          <tr>\n            <td style=\"padding:0 24px 32px 24px;\">\n              <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"background:rgba(240, 192, 64, 0.08); border:1px solid rgba(240, 192, 64, 0.3); border-radius:12px;\">\n                <tr>\n                  <td style=\"padding:24px;\">\n                    <p style=\"color:#f0c040; font-family:Arial, sans-serif; font-size:14px; font-weight:600; margin:0 0 12px 0; text-transform:uppercase; letter-spacing:1px;\">\n                      Suas credenciais de acesso\n                    </p>\n                    <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"font-family:'Courier New', monospace;\">\n                      <tr>\n                        <td style=\"color:#f0c040; font-size:13px; padding:6px 0;\">E-mail:</td>\n                        <td style=\"color:#fdf8f0; font-size:14px; padding:6px 0; text-align:right; word-break:break-all;\">\n                          maria@exemplo.com\n                        </td>\n                      </tr>\n                      <tr>\n                        <td style=\"color:#f0c040; font-size:13px; padding:6px 0;\">Senha temporária:</td>\n                        <td style=\"color:#fdf8f0; font-size:14px; padding:6px 0; text-align:right; word-break:break-all;\">\n                          Tmp-Doador-9x\n                        </td>\n                      </tr>\n                    </table>\n                    <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"margin-top:20px;\">\n                      <tr>\n                        <td align=\"center\">\n                          <a href=\"https://clama.me/login\" style=\"display:inline-block; background:#f0c040; color:#1a1611; padding:12px 28px; border-radius:999px; text-decoration:none; font-family:Arial, sans-serif; font-size:14px; font-weight:600;\">\n                            Entrar no Clama\n                          </a>\n                        </td>\n                      </tr>\n                    </table>\n                    <p style=\"color:rgba(253, 248, 240, 0.7); font-family:Arial, sans-serif; font-size:12px; line-height:1.5; margin:16px 0 0 0; text-align:center;\">\n                      Ou copie o link: https://clama.me/login\n                    </p>\n                  </td>\n                </tr>\n              </table>\n            </td>\n          </tr>\n\n          <!-- Aviso trocar senha -->\n          <tr>\n            <td style=\"color:rgba(253, 248, 240, 0.7); font-size:14px; line-height:1.6; padding:0 24px 32px 24px; font-family:Arial, sans-serif;\">\n              <p style=\"margin:0;\">\n                Por segurança, no primeiro acesso vamos pedir que você defina\n                uma nova senha. A senha temporária acima serve só para essa\n                primeira entrada.\n              </p>\n            </td>\n          </tr>\n\n          <!-- Versículo de rodapé -->\n          <tr>\n            <td align=\"center\" style=\"padding:0 24px 32px 24px;\">\n              <em style=\"color:#f0c040; font-size:14px; font-style:italic; display:block; line-height:1.6;\">\n                \"O Senhor é o meu pastor; nada me faltará.\"\n              </em>\n              <span style=\"color:#fdf8f0; font-size:12px; opacity:0.8; display:block; margin-top:8px;\">\n                — Salmo 23:1\n              </span>\n            </td>\n          </tr>\n\n          <!-- Link para o site -->\n          <tr>\n            <td align=\"center\" style=\"padding:24px;\">\n              <a href=\"https://clama.me\" style=\"color:#f0c040; text-decoration:none; font-size:14px; font-family:Arial, sans-serif;\">\n                clama.me\n              </a>\n            </td>\n          </tr>\n\n          <!-- Footer -->\n          <tr>\n            <td align=\"center\" style=\"padding:24px; border-top:1px solid rgba(240, 192, 64, 0.2);\">\n              <p style=\"color:#fdf8f0; opacity:0.6; font-size:12px; font-family:Arial, sans-serif; margin:0; line-height:1.5;\">\n                Este email foi enviado com amor pelo Clama.<br>\n                Não responda a este email — para contato, use contato@clama.me\n              </p>\n            </td>\n          </tr>\n        </table>\n      </td>\n    </tr>\n  </table>\n</body>\n</html>\n",
